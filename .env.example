# ==========================================
# SAP Daily Notes Management System - Environment Variables
# ==========================================

# Server Port (Render defaults to 10000)
PORT=10000

# Node Environment
NODE_ENV=production

# JWT Authentication Secret Key (Replace with your secure random string)
JWT_SECRET=sap_notes_fiori_super_secret_jwt_key_2026

# MongoDB Connection String (Optional: If omitted, the app automatically runs an in-memory MongoDB server with pre-seeded SAP notes)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sap_notes?retryWrites=true&w=majority

# Cloudinary Storage Credentials (Optional: Local disk storage in /uploads is active by default)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Vite Frontend API Base URL
VITE_API_URL=/api
